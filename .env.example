# N8n Multi-Server Audit Workflow - Example Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env with real credentials to version control

# ==========================================
# SERVER CONFIGURATION
# ==========================================

# Format: host|username|password|os_type|port|protocol
# Lines starting with # are ignored
# os_type: auto, linux, windows
# port: auto or specific port number
# protocol: auto, ssh, winrm

# Example Linux servers
# 192.168.1.10|admin|your_linux_password|auto|22|ssh
# 192.168.1.11|devops|your_linux_password|linux|22|ssh

# Example Windows servers
# 192.168.1.20|administrator|your_windows_password|auto|5986|winrm
# 192.168.1.21|svcaccount|your_windows_password|windows|5986|winrm

# Example: Auto-detect mixed environment
# 192.168.1.30|admin|password123|auto|auto|auto
# 192.168.1.31|admin|password123|auto|auto|auto

# ==========================================
# ALERT THRESHOLDS
# ==========================================

# Time window in minutes for log analysis (default: 15)
AUDIT_TIME_WINDOW_MIN=15

# Memory usage % to trigger critical alert (default: 85)
AUDIT_MEM_CRITICAL_PCT=85

# Disk usage % to trigger critical alert (default: 85)
AUDIT_DISK_CRITICAL_PCT=85

# CPU usage % to trigger critical alert (default: 90)
AUDIT_CPU_CRITICAL_PCT=90

# Maximum error lines to analyze (default: 50)
AUDIT_MAX_ERROR_LINES=50

# ==========================================
# TELEGRAM CONFIGURATION
# ==========================================

# Get your Chat ID: https://api.telegram.org/botYOUR_BOT_TOKEN/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ==========================================
# AI MODEL CONFIGURATION
# ==========================================

# AI Model: gemini, openai, anthropic, azure
AI_MODEL=gemini

# Google Gemini API Key (if using Gemini)
GEMINI_API_KEY=your_gemini_api_key

# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key

# Anthropic API Key (if using Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# ==========================================
# SCHEDULE CONFIGURATION
# ==========================================

# Run interval in minutes (default: 30)
SCHEDULE_INTERVAL_MINUTES=30

# ==========================================
# ADVANCED OPTIONS
# ==========================================

# SSH connection timeout in seconds (default: 10)
SSH_TIMEOUT_SECONDS=10

# WinRM connection timeout in seconds (default: 20)
WINRM_TIMEOUT_SECONDS=20

# Delay between Telegram messages in milliseconds (default: 2000)
TELEGRAM_MESSAGE_DELAY_MS=2000

# ==========================================
# LOG PATHS (Linux only, comma-separated)
# ==========================================

# Additional log paths to check
# LINUX_ERROR_LOG_PATHS=/var/log/syslog,/var/log/messages,/var/log/auth.log,/var/log/nginx/error.log